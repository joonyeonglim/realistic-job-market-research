{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joonyeonglim/realistic-job-market-research/review.schema.json",
  "title": "Realistic role review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "candidate_profile_version",
    "scope",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "candidate_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "kind",
        "statement",
        "coverage_limits"
      ],
      "properties": {
        "kind": {
          "enum": [
            "named_shortlist",
            "audited_ledger",
            "update_correction"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "coverage_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "company",
          "title",
          "url",
          "current_status",
          "requirements",
          "fit",
          "gates",
          "policy_flags",
          "evidence_quality",
          "company_identity",
          "finance",
          "location_work_policy",
          "hiring_process",
          "compensation",
          "application_stage",
          "offer_stage",
          "decision_reason",
          "unknowns",
          "resume_actions",
          "evidence"
        ],
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "current_status": {
            "enum": [
              "active",
              "closed",
              "ambiguous",
              "reposted"
            ]
          },
          "requirements": {
            "type": "object",
            "required": [
              "must_have",
              "preferred"
            ],
            "properties": {
              "must_have": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requirement",
                    "candidate_evidence",
                    "match"
                  ],
                  "properties": {
                    "requirement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "candidate_evidence": {
                      "type": "string",
                      "minLength": 1
                    },
                    "match": {
                      "enum": [
                        "confirmed",
                        "transferable",
                        "missing",
                        "unknown"
                      ]
                    }
                  }
                }
              },
              "preferred": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requirement",
                    "candidate_evidence",
                    "match"
                  ],
                  "properties": {
                    "requirement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "candidate_evidence": {
                      "type": "string",
                      "minLength": 1
                    },
                    "match": {
                      "enum": [
                        "confirmed",
                        "transferable",
                        "missing",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          },
          "fit": {
            "type": "object"
          },
          "gates": {
            "type": "object"
          },
          "policy_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_quality": {
            "type": "object",
            "required": [
              "grade",
              "freshness",
              "reason"
            ],
            "properties": {
              "grade": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unverified"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "mixed",
                  "stale",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "company_identity": {
            "type": "object"
          },
          "finance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "grade",
              "as_of",
              "facts",
              "evidence"
            ],
            "properties": {
              "grade": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "UNVERIFIED"
                ]
              },
              "as_of": {
                "type": "string",
                "minLength": 1
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          },
          "location_work_policy": {
            "type": "object"
          },
          "hiring_process": {
            "type": "object"
          },
          "compensation": {
            "type": "object"
          },
          "application_stage": {
            "enum": [
              "PREPARE",
              "CONDITIONAL",
              "DROP"
            ]
          },
          "offer_stage": {
            "enum": [
              "PASS",
              "HOLD",
              "NO_GO"
            ]
          },
          "decision_reason": {
            "type": "string",
            "minLength": 1
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resume_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        }
      }
    }
  }
}
