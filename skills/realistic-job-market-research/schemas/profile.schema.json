{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joonyeonglim/realistic-job-market-research/profile.schema.json",
  "title": "Candidate profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "captured_at",
    "career_years",
    "candidate",
    "scoring",
    "preferences",
    "resume"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "career_years": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "candidate": {
      "type": "object",
      "required": [
        "target_roles",
        "defensible_level",
        "degree",
        "proven_strengths",
        "known_gaps"
      ],
      "properties": {
        "target_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defensible_level": {
          "type": "string",
          "minLength": 1
        },
        "degree": {
          "type": "string",
          "minLength": 1
        },
        "proven_strengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "model_version",
        "policy_source",
        "weight_method",
        "elicited_at",
        "rationale",
        "match_weights",
        "opportunity_weights",
        "match_values",
        "axis_values",
        "confidence_threshold",
        "sensitivity_profiles"
      ],
      "properties": {
        "model_version": {
          "const": "2026-08-v3"
        },
        "policy_source": {
          "type": "string",
          "minLength": 1
        },
        "weight_method": {
          "type": "string",
          "minLength": 1
        },
        "elicited_at": {
          "type": "string",
          "format": "date"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "match_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mandatory_requirements",
            "task_ownership",
            "production_delivery",
            "preferred_requirements",
            "level_scope",
            "domain_onboarding"
          ],
          "properties": {
            "mandatory_requirements": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "task_ownership": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "production_delivery": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "preferred_requirements": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "level_scope": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "domain_onboarding": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "opportunity_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "match_score",
            "finance",
            "location_work_policy",
            "hiring_process",
            "compensation_level"
          ],
          "properties": {
            "match_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "finance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "location_work_policy": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hiring_process": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "compensation_level": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "match_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmed",
            "transferable",
            "missing",
            "unknown"
          ],
          "properties": {
            "confirmed": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "transferable": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "missing": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "unknown": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "axis_values": {
          "type": "object"
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sensitivity_profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match_score",
              "finance",
              "location_work_policy",
              "hiring_process",
              "compensation_level"
            ],
            "properties": {
              "match_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "finance": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "location_work_policy": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "hiring_process": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "compensation_level": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "preferences": {
      "type": "object"
    },
    "resume": {
      "type": "object"
    }
  }
}
