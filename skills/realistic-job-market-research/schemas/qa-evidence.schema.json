{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joonyeonglim/realistic-job-market-research/qa-evidence.schema.json",
  "title": "Generated QA evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "recorded_at",
    "manifest_sha256",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "required": [
        "self_test",
        "synthetic_smoke",
        "reproducibility",
        "browser"
      ],
      "properties": {
        "self_test": {
          "type": "object"
        },
        "synthetic_smoke": {
          "type": "object"
        },
        "reproducibility": {
          "type": "object"
        },
        "browser": {
          "type": "object"
        }
      }
    }
  }
}
