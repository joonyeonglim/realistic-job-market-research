{
  "schema_version": 1,
  "sensitive_key_pattern": "(?:^|_)(?:api_?key|access_?token|refresh_?token|secret|password|passwd|cookie|authorization|credential|private_?key|email|phone|mobile|home_?address)(?:$|_)",
  "sensitive_query_key_pattern": "^(?:token|access_token|refresh_token|api_key|key|secret|signature|sig|auth|authorization|password)$",
  "content_patterns": [
    {"name": "email address", "pattern": "[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}", "flags": "i"},
    {"name": "phone number", "pattern": "(?:\\+82[- ]?1[016789][- ]?\\d{3,4}[- ]?\\d{4}|01[016789][ -]\\d{3,4}[ -]\\d{4})", "flags": ""},
    {"name": "OpenAI-style key", "pattern": "(^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9]{20,}([^A-Za-z0-9]|$)", "flags": ""},
    {"name": "GitHub token", "pattern": "gh[pousr]_[A-Za-z0-9]{20,}", "flags": ""},
    {"name": "bearer token", "pattern": "Bearer\\s+[A-Za-z0-9._~+/-]{16,}", "flags": "i"},
    {"name": "private key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "flags": ""},
    {"name": "assigned credential", "pattern": "(?:api[_-]?key|access[_-]?token|password)\\s*[:=]\\s*[^\\s,;]{8,}", "flags": "i"}
  ]
}
